{
    "name": "@workleap/telemetry",
    "version": "4.1.1",
    "description": "A telemetry library for Workleap's web applications.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-telemetry.git",
        "directory": "packages/telemetry"
    },
    "files": [
        "src",
        "dist",
        "skills",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/js/index.ts",
        "./react": "./src/react/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/js/index.d.ts",
                "import": "./dist/js/index.js",
                "default": "./dist/js/index.js"
            },
            "./react": {
                "types": "./dist/react/index.d.ts",
                "import": "./dist/react/index.js",
                "default": "./dist/react/index.js"
            }
        },
        "access": "public",
        "provenance": true,
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "prepack": "node ./scripts/agent-skill.mjs copy",
        "postpack": "node ./scripts/agent-skill.mjs clean",
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@workleap-telemetry/core": "workspace:^",
        "@workleap/honeycomb": "workspace:^",
        "@workleap/logging": "^2.0.1",
        "@workleap/logrocket": "workspace:^",
        "@workleap/mixpanel": "workspace:^"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@types/js-cookie": "3.0.6",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@workleap/rslib-configs": "2.0.0",
        "@workleap/typescript-configs": "5.0.0",
        "typescript": "7.0.2"
    },
    "peerDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@types/react": "^18.0.0 || ^19.0.0",
        "logrocket": "^12.4.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@opentelemetry/api": {
            "optional": true
        },
        "@types/react": {
            "optional": true
        },
        "logrocket": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    }
}

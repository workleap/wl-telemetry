{
    "name": "@workleap/telemetry",
    "author": "Workleap",
    "version": "3.0.5",
    "description": "A telemetry library for Workleap's web applications.",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-telemetry.git",
        "directory": "packages/telemetry"
    },
    "type": "module",
    "publishConfig": {
        "access": "public",
        "provenance": true,
        "exports": {
            ".": {
                "types": "./dist/js/index.d.ts",
                "import": "./dist/js/index.js",
                "default": "./dist/js/index.js"
            },
            "./react": {
                "types": "./dist/react/index.d.ts",
                "import": "./dist/react/index.js",
                "default": "./dist/react/index.js"
            }
        }
    },
    "exports": {
        ".": "./src/js/index.ts",
        "./react": "./src/react/index.ts"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "eslint": "eslint . --max-warnings=0 --cache --cache-location node_modules/.cache/eslint",
        "typecheck": "tsgo"
    },
    "peerDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "logrocket": "^12.1.1",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@opentelemetry/api": {
            "optional": true
        },
        "logrocket": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "dependencies": {
        "@opentelemetry/sdk-trace-web": "^2.9.0",
        "@workleap-telemetry/core": "workspace:^",
        "@workleap/honeycomb": "workspace:^",
        "@workleap/logging": "^2.0.0",
        "@workleap/logrocket": "workspace:^",
        "@workleap/mixpanel": "workspace:^"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@rsbuild/core": "2.1.5",
        "@rslib/core": "0.23.2",
        "@types/js-cookie": "3.0.6",
        "@types/node": "26.1.1",
        "@types/react": "19.2.17",
        "@typescript-eslint/parser": "8.63.0",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/eslint-configs": "2.0.4",
        "@workleap/rslib-configs": "1.2.1",
        "@workleap/typescript-configs": "5.0.0",
        "eslint": "9.39.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.63.0"
    },
    "sideEffects": false
}

{
    "name": "@workleap-telemetry/core",
    "version": "2.0.6",
    "description": "A package including telemetry core utilities for Workleap web applications.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-telemetry.git",
        "directory": "packages/core"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": "./src/index.ts",
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsgo",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@workleap/logging": "^2.0.1",
        "js-cookie": "^3.0.8",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "@rsbuild/core": "2.2.14",
        "@rslib/core": "1.0.3",
        "@types/js-cookie": "3.0.6",
        "@types/node": "26.6.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/rslib-configs": "2.0.0",
        "@workleap/typescript-configs": "5.0.0",
        "happy-dom": "21.0.4",
        "typescript": "7.0.2",
        "vitest": "5.0.5"
    }
}

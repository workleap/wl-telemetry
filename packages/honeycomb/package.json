{
    "name": "@workleap/honeycomb",
    "version": "8.3.1",
    "description": "Shared Honeycomb configuration for web application at Workleap.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-telemetry.git",
        "directory": "packages/honeycomb"
    },
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": "./src/js/index.ts",
        "./react": "./src/react/index.ts"
    },
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/js/index.d.ts",
                "import": "./dist/js/index.js",
                "default": "./dist/js/index.js"
            },
            "./react": {
                "types": "./dist/react/index.d.ts",
                "import": "./dist/react/index.js",
                "default": "./dist/react/index.js"
            }
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "dependencies": {
        "@honeycombio/opentelemetry-web": "^1.5.1",
        "@opentelemetry/auto-instrumentations-web": "^0.68.0",
        "@opentelemetry/instrumentation": "^0.223.0",
        "@opentelemetry/instrumentation-document-load": "^0.68.0",
        "@opentelemetry/instrumentation-fetch": "^0.223.0",
        "@opentelemetry/instrumentation-user-interaction": "^0.67.0",
        "@opentelemetry/instrumentation-xml-http-request": "^0.223.0",
        "@opentelemetry/otlp-exporter-base": "^0.223.0",
        "@opentelemetry/otlp-transformer": "^0.223.0",
        "@opentelemetry/sdk-trace": "^2.12.0",
        "@workleap-telemetry/core": "workspace:^",
        "@workleap/logging": "^2.1.0"
    },
    "devDependencies": {
        "@opentelemetry/api-logs": "0.223.0",
        "@opentelemetry/core": "2.12.0",
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "happy-dom": "21.0.4",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    },
    "peerDependencies": {
        "@opentelemetry/api": "^1.9.1",
        "@types/react": "^18.0.0 || ^19.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=21.1.0"
    }
}

{
    "name": "@all-platforms/app",
    "version": "0.0.0",
    "private": true,
    "description": "Sample application to test all the telemetry platforms integration.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "type": "module",
    "scripts": {
        "dev": "rsbuild dev --config rsbuild.dev.ts",
        "build": "pnpm build:rsbuild && pnpm build:copy-public-files",
        "build:rsbuild": "rsbuild build --config rsbuild.build.ts",
        "build:copy-public-files": "copyfiles -u 1 public/favicon.png dist",
        "serve-build": "pnpm http-server dist --ssl --key ../local.workleap.com-key.pem --cert ../local.workleap.com.pem -p 443 -P https://local.workleap.com? -c-1",
        "typecheck": "tsc"
    },
    "dependencies": {
        "@tanstack/react-query": "5.107.1",
        "@workleap/logging": "2.1.0",
        "@workleap/telemetry": "workspace:*",
        "logrocket": "12.4.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rspack/core": "2.3.1",
        "@types/node": "26.6.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@workleap/browserslist-config": "3.1.0",
        "@workleap/rsbuild-configs": "5.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "browserslist": "4.29.5",
        "copyfiles": "2.4.1",
        "http-server": "14.1.1",
        "typescript": "7.0.2"
    }
}

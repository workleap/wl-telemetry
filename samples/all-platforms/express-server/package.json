        "express": "5.2.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.2",
        "@types/cors": "2.8.19",
        "@types/express": "5.0.6",
        "@types/node": "25.9.1",
        "@typescript-eslint/parser": "8.60.1",
        "@typescript/native-preview": "7.0.0-dev.20260602.1",
        "@workleap/eslint-configs": "2.0.3",
        "@workleap/typescript-configs": "4.0.2",
        "eslint": "9.39.2",
        "tsx": "4.22.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.60.1"
    }
}

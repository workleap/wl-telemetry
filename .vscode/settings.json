{
    "search.exclude": {
        "**/node_modules*": true,
        "**/dist*": true
    },

    // Formatting and linting are handled by oxfmt and oxlint through the oxc extension.
    // Type-aware so the editor shows the same findings as `pnpm oxlint`.
    "oxc.typeAware": true,

    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",

    "editor.codeActionsOnSave": {
        "source.format.oxc": "always",
        "source.fixAll.oxc": "always"
    },
    "[html]": {
        "editor.formatOnSave": false
    },

    // Languages
    "js/ts.preferences.useAliasesForRenames": false,
    // TypeScript 7 doesn't ship a tsserver, so the editor can't use the workspace version as its SDK.

    // "typescript.experimental.useTsgo": true,
    // "typescript.tsdk": "node_modules\\@typescript\\native-preview\\lib",

    "css.validate": false,

    // Settings for third parties that are frequently used
    "files.associations": {
        "*.snap": "javascriptreact",
        "turbo.json": "jsonc"
    },

    "github.copilot.chat.commitMessageGeneration.instructions": [
        {
            "file": ".github/copilot/commit-message-instructions.md"
        }
    ]
}
